# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/campushub
# Set to true to run against a throwaway in-memory MongoDB (dev/test only).
# MONGO_URI is not needed in that mode. Rejected when NODE_ENV=production.
USE_IN_MEMORY_DB=false
